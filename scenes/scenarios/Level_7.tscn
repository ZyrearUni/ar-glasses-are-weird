[node name="Option1" type="Node" parent="stage/City/CutsceneArea" index="2" unique_id=1332933970 node_paths=PackedStringArray("Player", "Speakers")]
script = ExtResource("5_18y80")
Player = NodePath("../../../Player")
Dialogues = Array[String](["Menudo día, ¿no crees?", "Espero que tu nueva amiga esté bien. La situación era algo seria.", "¡Bueno! Hicimos lo que pudimos, y eso es lo que importa. ¿Verdad, superestrella?", "Y en cualquier caso, si alguien nos pregunta tengo una grabación de todo.", "Y si no, ¡tu madre se pueden encargar!", "...", "¿Por qué pones esa cara, superestrella?", "Bueno, no será nada grave. ¡Andando!"])
SpeakerNames = Array[String](["Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy"])
Speakers = [NodePath("../../../../Skippy")]

[node name="Option2" type="Node" parent="stage/City/CutsceneArea" index="3" unique_id=344858681 node_paths=PackedStringArray("Player", "Speakers")]
script = ExtResource("6_7lg7l")
Player = NodePath("../../../Player")
Dialogues = Array[String](["¡Hola, superestrella!", "Siento mucho contarte esto así de repente, pero...", "Voy a tener que desactivarme de manera temporal.", "Tu nueva amiga, Raquel... La policía querrá los datos intactos, y no puedo correr el riesgo de sobreescribirlos con más grabaciones y recopilación de datos.", "¡Pero tú no te preocupes! Estás cerca de casa, y cuando llegues tus padres lo tendrán todo controlado. ¿De acuerdo?", "...", "Bueno... Esto es ya una despedida. Mucha suerte, mi superestrella."])
SpeakerNames = Array[String](["Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy"])
Speakers = [NodePath("../../../../Skippy")]

