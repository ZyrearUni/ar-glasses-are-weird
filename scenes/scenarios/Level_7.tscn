script = ExtResource("6_7lg7l")
Player = NodePath("../../../Player")
Dialogues = Array[String](["¡Hola, superestrella!", "Siento mucho contarte esto así de repente, pero...", "Voy a tener que desactivarme de manera temporal.", "Tu nueva amiga, Raquel... La policía querrá los datos intactos, y no puedo correr el riesgo de sobreescribirlos con más grabaciones y recopilación de datos.", "¡Pero tú no te preocupes! Estás cerca de casa, y cuando llegues tus padres lo tendrán todo controlado. ¿De acuerdo?"])
SpeakerNames = Array[String](["Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy"])
Speakers = [NodePath("../../../../Skippy")]

