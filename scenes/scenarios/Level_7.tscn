script = ExtResource("5_18y80")
Player = NodePath("../../../Player")
Dialogues = Array[String](["Menudo día, ¿no crees?", "Espero que tu nueva amiga esté bien. La situación era algo seria.", "¡Bueno! Hicimos lo que pudimos, y eso es lo que importa. ¿Verdad, superestrella?", "Y en cualquier caso, si alguien nos pregunta tengo una grabación de todo.", "Y si no, ¡tu madre se pueden encargar!", "...", "¿Por qué pones esa cara, superestrella?"])
SpeakerNames = Array[String](["Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy"])
Speakers = [NodePath("../../../../Skippy")]

