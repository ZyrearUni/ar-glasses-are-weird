Dialogues = Array[String](["¡Qué día más productivo!", "Estoy deseando llegar ya a casa.", "...", "¿Sigues con preocupación sobre tu nueva amiga?", "Seguro que estará bien, superestrella. No tienes por qué preocuparte.", "¡Venga, vamos a comer!"])
SpeakerNames = Array[String](["Skippy", "Skippy", "Skippy", "Skippy", "Skippy", "Skippy"])
