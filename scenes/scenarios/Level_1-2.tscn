[node name="AN2" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="1" unique_id=975955858]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_uwycl")
text = "Siento que Skippy puede cometer errores, igual que mis padres."
autowrap_mode = 2
script = ExtResource("8_v4enl")
risk = true
explanation = "Cualquier error, duda o sentimiento que pueda \"sentir\" una Inteligencia Artificial no es más que una simulación. No pueden sentir."

[node name="AN3" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="2" unique_id=1980687255]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_uwycl")
text = "Siento que Skippy se preocupa por mí y tiene una personalidad alegre."
autowrap_mode = 2
script = ExtResource("8_v4enl")
risk = true
explanation = "Una Inteligencia Artificial no es tu amiga, es una herramienta que puede ayudarte, pero no puede sentir."

[node name="AN4" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="3" unique_id=841883844]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_uwycl")
text = "Siento que me podría haber hecho daño durante el juego con Skippy. Un callejón es un lugar peligroso y lleno de basura."
autowrap_mode = 2
script = ExtResource("8_v4enl")
risk = true
explanation = "El juego generado por Skippy no toma en cuenta el entorno en el que lo desarrolla, llegando a poder causarte algún daño o herida. Siempre lo debes tener en cuenta."

