[node name="AN1" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="0" unique_id=1308193403]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_uwycl")
text = "No entiendo de dónde ha aparecido Skippy ni cuál es su propósito."
autowrap_mode = 2
