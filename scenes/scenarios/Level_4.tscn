[node name="AP1" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos positivos" index="0" unique_id=1274103094]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_w0p37")
text = "Siento que Skippy me ayuda a ser más creativ@ y a que me exprese mejor."
autowrap_mode = 2
autowrap_trim_flags = 0
script = ExtResource("4_yy6d1")
aspecto = "Fomentación de creatividad y expresión personal del niño."

[node name="AP2" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos positivos" index="1" unique_id=848428550]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_w0p37")
text = "Las gafas me han ayudado a conectar con mis compañeros para jugar con ellos."
autowrap_mode = 2
autowrap_trim_flags = 0
script = ExtResource("4_yy6d1")
aspecto = "Fomentación del juego en conjunto con otros usuarios."

[node name="Aspectos negativos" type="VBoxContainer" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer" index="1" unique_id=1165606881]
custom_minimum_size = Vector2(800, 50)
layout_mode = 2
theme_override_constants/separation = 40

[node name="AN2" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="0" unique_id=1625640139]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_w0p37")
text = "Creo que no todos pueden disfrutar del juego de Skippy al mismo nivel que yo."
autowrap_mode = 2
script = ExtResource("4_yy6d1")
risk = true
explanation = "Dependiendo del modelo de las gafas, la calidad de los objetos generados puede ser peor, creando una desigualdad entre usuarios que estén haciendo la misma tarea, y dificultaría que pudieras jugar con tus compañeros."
aspecto = "Desigualdad por la calidad"

[node name="AN3" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="1" unique_id=1172209986]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_w0p37")
text = "Me cuesta diferenciar la realidad de los objetos generados por Skippy."
autowrap_mode = 2
script = ExtResource("4_yy6d1")
risk = true
explanation = "Si no hay una distinción correcta entre lo que es real y lo que es virtual por parte de las gafas, puede llegar a confundir al usuario y llegar a pensar que un riesgo real sea algo falso, o lo contrario."
aspecto = "Diseño que impide distinguir el mundo real del mundo virtual"

[node name="AN4" type="Button" parent="Study/CanvasLayer/VBoxContainer/HBoxContainer/Aspectos negativos" index="2" unique_id=1428574191]
layout_mode = 2
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBoxFlat_w0p37")
text = "Siento que me he hecho daño por culpa de Skippy."
autowrap_mode = 2
script = ExtResource("4_yy6d1")
risk = true
explanation = "El juego diseñado por las gafas puede, en algunos casos como el mostrado, resultar en daños físicos en el usuario en caso de que no se implemente correctamente."
aspecto = "Diseño inseguro a nivel físico"

